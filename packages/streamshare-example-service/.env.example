TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=fr-FR

HOST=127.0.0.1
PORT=4046
DEMO_MEDIA_URL=/assets/demo.mp4

# Optional: basic, apikey, or deviceCode.
DEMO_AUTH_METHOD=
