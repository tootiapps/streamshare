{
  "name": "@streamshare/remote-protocol",
  "version": "1.0.0",
  "description": "Versioned protocol shared by StreamShare remote playback senders and receivers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepack": "pnpm run test",
    "release:check": "pnpm run test && pnpm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "author": "TootiApps",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tootiapps/streamshare.git",
    "directory": "packages/remote-protocol"
  },
  "homepage": "https://docs.tootiapps.com/clients/",
  "bugs": {
    "url": "https://github.com/tootiapps/streamshare/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
