{
  "name": "@streamshare/service",
  "version": "1.0.1",
  "description": "Typed HTTP protocol and runtime validators for StreamShare services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "readme.md",
    "CHANGELOG.md",
    "LICENSE",
    "compatibility.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepack": "pnpm run test",
    "release:check": "pnpm run test && pnpm pack --dry-run"
  },
  "keywords": [
    "streamshare",
    "service",
    "sdk",
    "protocol"
  ],
  "author": "TootiApps",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tootiapps/streamshare.git",
    "directory": "packages/streamshare-service"
  },
  "homepage": "https://docs.tootiapps.com/services/",
  "bugs": {
    "url": "https://github.com/tootiapps/streamshare/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
