{
  "name": "@streamshare/plugin-cli",
  "version": "1.0.0",
  "description": "Development, validation and packaging CLI for StreamShare addons",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "streamshare-plugin-cli": "./bin/streamshare-plugin-cli.cjs"
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepack": "pnpm run test",
    "release:check": "pnpm run test && pnpm pack --dry-run"
  },
  "keywords": [
    "streamshare",
    "addon",
    "plugin",
    "cli",
    "development"
  ],
  "author": "TootiApps",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tootiapps/streamshare.git",
    "directory": "packages/plugin-cli"
  },
  "homepage": "https://docs.tootiapps.com/addons/guides/development-mode",
  "bugs": {
    "url": "https://github.com/tootiapps/streamshare/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@streamshare/plugin-sdk": "workspace:*",
    "express": "^4.19.2",
    "ws": "^8.17.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.28.2",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/adm-zip": "^0.5.8"
  }
}
